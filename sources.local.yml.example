# 프로젝트 ↔ 맥 폴더 연결 (연결고리).
# 실제 파일은 sources.local.yml 로 복사해서 쓰고, 그 파일은 .gitignore 로 저장소에 올라가지 않는다.
# 키는 archive.yml 의 slug. source 는 맥의 폴더 경로. include 는 가져올 파일 패턴.
retro:
  source: ~/Library/Mobile Documents/com~apple~CloudDocs/폴더/프로젝트 회고 및 이론서
  include: ["*.pdf", "*.pptx", "*.docx", "*.html"]
  exclude: []
  recursive: false
